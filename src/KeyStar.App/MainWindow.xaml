<Window x:Class="KeyStar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KeyStar.App.Controls"
        Title="KeyStar · 键盘 鼠标 手柄 使用统计"
        Icon="Assets/KeyStar.ico"
        Width="1360" Height="880" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <!-- 蓝图网格底纹：只在余光里出现 -->
        <Rectangle Fill="{StaticResource GridPatternBrush}" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== 顶栏 ==================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelDeepBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="34"
                            CornerRadius="3"
                            Background="{StaticResource NasaBlueBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="K"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource InkOnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KEYSTAR"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="19" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                            <Border Width="9" Height="9"
                                    Margin="9,4,0,0"
                                    CornerRadius="0,2,2,0"
                                    Background="{StaticResource WormRedBrush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="MISSION INPUT LOG"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="12,5,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="键盘 · 鼠标 · 手柄 按下次数统计"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="StartupCheckBox"
                                  Content="登录 Windows 后自动启动"
                                  Focusable="False"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  Checked="StartupCheckBox_Changed"
                                  Unchecked="StartupCheckBox_Changed" />
                        <Border x:Name="StatusBadge"
                                Background="{StaticResource StatusOkBrush}"
                                BorderBrush="{StaticResource GreenBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="10,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                         Fill="{StaticResource GreenBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText"
                                           Text="正在采集"
                                           Margin="7,0,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource GreenBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 范围工具条 ==================== -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyleWithStripe}"
                    Margin="20,16,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题行 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="01" Style="{StaticResource ModuleNumberStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="数据范围"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource FaintTextStyle}"
                                   Margin="16,0,16,0"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Text="「全部」与「今天」会随统计自动刷新；选择「自定义」后用日历指定起止日期与时间，再点击「应用范围」。" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="色阶" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton x:Name="ScaleModeSquareRootRadio"
                                         Content="平方根"
                                         GroupName="ScaleMode"
                                         IsChecked="True"
                                         Style="{StaticResource RangeChipStyle}"
                                         Checked="ScaleModeRadio_Checked" />
                            <RadioButton x:Name="ScaleModeLinearRadio"
                                         Content="线性"
                                         GroupName="ScaleMode"
                                         Style="{StaticResource RangeChipStyle}"
                                         Checked="ScaleModeRadio_Checked" />
                        </StackPanel>
                    </Grid>

                    <!-- 范围选项 + 自定义区间 -->
                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="范围" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <RadioButton x:Name="RangeAllRadio"
                                         Content="全部"
                                         Tag="All"
                                         GroupName="RangePreset"
                                         IsChecked="True"
                                         Style="{StaticResource RangeChipStyle}"
                                         Checked="RangePresetRadio_Checked" />
                            <RadioButton x:Name="RangeTodayRadio"
                                         Content="今天"
                                         Tag="Today"
                                         GroupName="RangePreset"
                                         Style="{StaticResource RangeChipStyle}"
                                         Checked="RangePresetRadio_Checked" />
                            <RadioButton x:Name="RangeCustomRadio"
                                         Content="自定义"
                                         Tag="Custom"
                                         GroupName="RangePreset"
                                         Style="{StaticResource RangeChipStyle}"
                                         Checked="RangePresetRadio_Checked" />
                        </StackPanel>

                        <Border x:Name="CustomRangePanel"
                                Margin="0,12,0,0"
                                Padding="14,12"
                                Visibility="Collapsed"
                                Background="{StaticResource PanelDeepBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="从" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <DatePicker x:Name="StartDatePicker"
                                            Width="136"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            ToolTip="点击右侧日历图标选择开始日期" />
                                <TextBox x:Name="StartTimeTextBox"
                                         Width="72"
                                         Margin="0,0,18,0"
                                         Text="00:00"
                                         TextAlignment="Center"
                                         FontFamily="{StaticResource MonoFont}"
                                         VerticalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         ToolTip="开始时间，格式 HH:mm" />
                                <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,18,0" VerticalAlignment="Center" />
                                <DatePicker x:Name="EndDatePicker"
                                            Width="136"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            ToolTip="点击右侧日历图标选择结束日期" />
                                <TextBox x:Name="EndTimeTextBox"
                                         Width="72"
                                         Margin="0,0,18,0"
                                         TextAlignment="Center"
                                         FontFamily="{StaticResource MonoFont}"
                                         VerticalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         ToolTip="结束时间，格式 HH:mm（不含该时刻）" />
                                <Button x:Name="ApplyRangeButton"
                                        Content="应用范围"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        VerticalAlignment="Center"
                                        Click="ApplyRangeButton_Click" />
                            </WrapPanel>
                        </Border>

                        <TextBlock x:Name="RangeValidationText"
                                   Foreground="{StaticResource AmberBrush}"
                                   Margin="0,8,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 今日时段分布 -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="所选范围内每 10 分钟输入量"
                                       Style="{StaticResource SectionLabelStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DailyTimelineSummaryText"
                                       Grid.Column="1"
                                       Margin="16,0,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Text="暂无输入" />
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource FaintTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="按当地时间 00:00 — 24:00 排列 · 悬停查看该时段次数" />
                        </Grid>
                        <controls:TenMinuteTimelineControl x:Name="DailyTimeline" Grid.Row="1" Margin="0,6,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== 主内容：左侧导航 + 四页 ==================== -->
            <TabControl Grid.Row="2" Margin="20,16,20,0">

                <!-- ===== 总览 ===== -->
                <TabItem MinWidth="104" ToolTip="本次运行量、实时按键与设备状态">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="01" Style="{StaticResource ModuleNumberStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="总览" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <!-- 本次运行 -->
                            <Border Style="{StaticResource CardStyleWithStripe}">
                                <StackPanel>
                                    <TextBlock Text="本次运行" Style="{StaticResource SectionLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="TotalCountText"
                                                   Text="0"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="46"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource NasaBlueBrush}"
                                                   VerticalAlignment="Bottom" />
                                        <TextBlock Text="次输入"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="8,0,0,8"
                                                   VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <TextBlock x:Name="TotalHistoryText"
                                               Text="总数量：0"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 快捷操作 -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="操作" Style="{StaticResource SectionLabelStyle}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="PauseButton"
                                                Content="暂停采集"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="0,0,8,8"
                                                Click="PauseButton_Click" />
                                        <Button Content="清零本次显示"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,8"
                                                Click="ClearButton_Click" />
                                        <Button x:Name="SaveNowButton"
                                                Content="立即保存"
                                                IsEnabled="False"
                                                Margin="0,0,8,8"
                                                Click="SaveNowButton_Click" />
                                        <Button x:Name="ExportButton"
                                                Content="导出 CSV"
                                                IsEnabled="False"
                                                Margin="0,0,8,8"
                                                Click="ExportButton_Click" />
                                        <Button x:Name="ResetButton"
                                                Content="重置记录（新建存档）"
                                                Style="{StaticResource DangerButtonStyle}"
                                                IsEnabled="False"
                                                Margin="0,0,8,8"
                                                Click="ResetButton_Click" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource FaintTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Text="「暂停采集」只停止计数，不影响已保存的统计；「重置记录」会把当前数据库归档到 Data\archives 后从零开始。" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 实时状态 -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="02" Style="{StaticResource ModuleNumberStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="当前按下中的键或按钮"
                                               Style="{StaticResource SectionLabelStyle}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Border Grid.Row="1"
                                        Background="{StaticResource PanelDeepBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="14,12"
                                        Margin="0,10,0,0">
                                    <TextBlock x:Name="PressedKeysText"
                                               Text="无"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource CyanBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                    <TextBlock x:Name="LastInputText"
                                               Text="等待输入…"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="UnknownInputText"
                                               Text="未识别输入：0"
                                               Foreground="{StaticResource AmberBrush}"
                                               Margin="0,6,0,0" />
                                    <TextBlock x:Name="GamepadStatusText"
                                               Text="手柄：未连接"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,6,0,0" />
                                    <TextBlock x:Name="StorageStatusText"
                                               Text="本地数据：正在初始化…"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== 键盘 ===== -->
                <TabItem MinWidth="104" ToolTip="键盘与鼠标热力图">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="02" Style="{StaticResource ModuleNumberStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="键盘" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="03" Style="{StaticResource ModuleNumberStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="键盘与鼠标热力图"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="0" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <Border Width="18" Height="12"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,5,0" />
                                <TextBlock Text="低" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <Border Width="160" Height="12"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        Background="{StaticResource HeatRampBrush}" />
                                <TextBlock Text="高" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="· 键盘与鼠标分别取各自最大值"
                                           Style="{StaticResource FaintTextStyle}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0"
                                Padding="12">
                            <controls:KeyboardHeatmapControl x:Name="HeatmapKeyboard" MinHeight="260" />
                        </Border>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HeatmapRangeText"
                                       Text="正在加载范围…"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="HeatmapTotalText"
                                       Grid.Column="1"
                                       Text="所选范围总计：0"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="HeatmapUpdatedText"
                                       Grid.Column="2"
                                       Text="尚未更新"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== 手柄 ===== -->
                <TabItem MinWidth="104" ToolTip="手柄按键热力图">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="03" Style="{StaticResource ModuleNumberStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="手柄" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="04" Style="{StaticResource ModuleNumberStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="手柄热力图"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="0" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <Border Width="18" Height="12"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,5,0" />
                                <TextBlock Text="低" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <Border Width="160" Height="12"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        Background="{StaticResource HeatRampBrush}" />
                                <TextBlock Text="高" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0"
                                Padding="12">
                            <controls:GamepadHeatmapControl x:Name="HeatmapGamepad" MinHeight="220" />
                        </Border>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GamepadTotalText"
                                       Text="手柄按键总计：0"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource FaintTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="只统计按键与扳机的按下次数，不记录摇杆位置和扳机数值" />
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== 记录 ===== -->
                <TabItem MinWidth="104" ToolTip="所选范围内的按键明细列表">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="04" Style="{StaticResource ModuleNumberStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="记录" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="05" Style="{StaticResource ModuleNumberStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="所选范围内的按键与按钮"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource FaintTextStyle}"
                                       Margin="16,0,16,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="按次数从多到少排列；「状态」列显示该键当前是否正被按下" />
                            <CheckBox x:Name="ActiveOnlyCheckBox"
                                      Grid.Column="2"
                                      Content="只显示有次数或按下中的键"
                                      Focusable="False"
                                      VerticalAlignment="Center"
                                      Checked="FilterChanged"
                                      Unchecked="FilterChanged" />
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0"
                                Padding="1">
                            <DataGrid x:Name="KeyGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      RowHeaderWidth="0"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="按键/按钮" Binding="{Binding DisplayName}" Width="2*" />
                                    <DataGridTextColumn Header="区域" Binding="{Binding Category}" Width="*" />
                                    <DataGridTextColumn Header="次数" Binding="{Binding Count, StringFormat={}{0:N0}}" Width="*" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding PressedText}" Width="*" />
                                    <DataGridTextColumn Header="按键标识" Binding="{Binding Id}" Width="1.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ==================== 页脚 ==================== -->
            <Border Grid.Row="3"
                    Background="{StaticResource PanelDeepBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,9"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
